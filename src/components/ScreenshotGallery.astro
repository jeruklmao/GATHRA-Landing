---
import SectionHeading from './SectionHeading.astro';

const previews = [
  {
    src: '/images/app/gathra-route-alternatives.webp',
    alt: 'Tampilan aplikasi GATHRA dengan poligon area pemantauan, marker sensor, serta rute terpilih dan rute alternatif.',
    number: '01',
    title: 'Bandingkan rute dengan konteks kondisi banjir.',
    description: 'Pilihan rute, tingkat risiko, dan batas cakupan pemantauan disajikan bersama.',
    eager: true,
  },
  {
    src: '/images/app/gathra-sensor-detail.webp',
    alt: 'Detail sensor GATHRA yang menampilkan risiko banjir sedang, ketinggian air, jarak permukaan, suhu, dan kelembapan.',
    number: '02',
    title: 'Baca kondisi sensor yang mendukung area pemantauan.',
    description: 'Detail pengukuran membantu menjelaskan dari mana kondisi area berasal.',
  },
  {
    src: '/images/app/gathra-navigation.webp',
    alt: 'Tampilan navigasi turn-by-turn GATHRA dengan petunjuk belok, rute, dan area pemantauan banjir pada peta.',
    number: '03',
    title: 'Ikuti navigasi saat kondisi tetap terlihat.',
    description: 'Petunjuk perjalanan, progres, dan area pemantauan hadir dalam tampilan navigasi.',
  },
];
---

<section class="section section--muted gallery" id="aplikasi" aria-labelledby="gallery-heading">
  <div class="container">
    <div id="gallery-heading">
      <SectionHeading
        eyebrow="Produk saat ini"
        title="GATHRA di Android"
        description="Tampilan berikut berasal dari aplikasi GATHRA saat ini—bukan ilustrasi antarmuka."
      />
    </div>
    <div class="gallery__grid">
      {
        previews.map((preview, index) => (
          <figure class:list={['preview', { 'preview--primary': index === 0 }]}>
            <div class="preview__phone">
              <img
                src={preview.src}
                width="720"
                height="1600"
                alt={preview.alt}
                loading={preview.eager ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
            <figcaption>
              <span>{preview.number} · Aplikasi Android</span>
              <h3>{preview.title}</h3>
              <p>{preview.description}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: start;
  }
  .preview {
    min-width: 0;
    margin: 0;
  }
  .preview__phone {
    width: min(100%, 21rem);
    margin-inline: auto;
    padding: 0.38rem;
    border: 1px solid rgb(0 52 79 / 30%);
    border-radius: clamp(2rem, 4vw, 3rem);
    background: #101820;
    box-shadow: var(--shadow-md);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .preview:hover .preview__phone {
    transform: translateY(-4px);
    box-shadow: var(--shadow-phone);
  }
  .preview__phone img {
    width: 100%;
    height: auto;
    border-radius: clamp(1.72rem, 3.7vw, 2.65rem);
  }
  figcaption {
    max-width: 21rem;
    margin: 1.4rem auto 0;
  }
  figcaption > span {
    color: var(--color-blue-700);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  figcaption h3 {
    margin-top: 0.45rem;
  }
  figcaption p {
    margin-top: 0.55rem;
    color: var(--color-neutral-600);
    font-size: 0.88rem;
  }
  @media (max-width: 56rem) {
    .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 3.5rem;
    }
    .preview--primary {
      grid-column: 1 / -1;
      width: min(100%, 24rem);
      justify-self: center;
    }
  }
  @media (max-width: 38rem) {
    .gallery__grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
    .preview--primary {
      grid-column: auto;
      width: auto;
    }
    .preview__phone {
      width: min(82vw, 21rem);
    }
  }
</style>
