---
import SectionHeading from './SectionHeading.astro';

const stages = [
  {
    name: 'GATHRA Node',
    role: 'Sensor lapangan',
    detail: 'Mengukur jarak permukaan air, suhu, dan kelembapan secara berkala.',
    connection: 'LoRa',
    icon: 'sensor',
  },
  {
    name: 'GATHRA Gateway',
    role: 'Penghubung lapangan',
    detail: 'Menerima pengukuran melalui LoRa dan meneruskannya lewat Internet.',
    connection: 'Internet',
    icon: 'gateway',
  },
  {
    name: 'Backend GATHRA',
    role: 'Data + analisis',
    detail: 'Menyimpan pengamatan, menilai kondisi banjir, dan mengevaluasi paparan rute.',
    connection: 'Informasi',
    icon: 'backend',
  },
  {
    name: 'Aplikasi Android',
    role: 'Informasi + navigasi',
    detail: 'Menampilkan kondisi sensor, area pemantauan, alternatif rute, dan panduan perjalanan.',
    icon: 'android',
  },
];
---

<section class="section workflow" id="cara-kerja" aria-labelledby="workflow-heading">
  <div class="container">
    <div id="workflow-heading">
      <SectionHeading
        eyebrow="Alur informasi"
        title="Cara kerja GATHRA"
        description="Pengukuran lapangan bergerak melalui satu alur yang jelas hingga menjadi konteks banjir dan perjalanan di aplikasi."
      />
    </div>

    <ol class="architecture" aria-label="Alur GATHRA dari sensor lapangan ke aplikasi Android">
      {
        stages.map((stage) => (
          <li class="architecture__stage">
            <article class="architecture__card">
              <div class="architecture__icon" aria-hidden="true">
                {stage.icon === 'sensor' && (
                  <svg viewBox="0 0 40 40">
                    <path d="M10 30V12a4 4 0 0 1 4-4h12a4 4 0 0 1 4 4v18" />
                    <path d="M6 30h28M14 19c4-3 8-3 12 0M16 24c3-2 5-2 8 0" />
                  </svg>
                )}
                {stage.icon === 'gateway' && (
                  <svg viewBox="0 0 40 40">
                    <rect x="8" y="19" width="24" height="14" rx="3" />
                    <path d="M20 19V8M14 12a8 8 0 0 1 12 0M10 8a14 14 0 0 1 20 0M14 27h.01M20 27h.01" />
                  </svg>
                )}
                {stage.icon === 'backend' && (
                  <svg viewBox="0 0 40 40">
                    <rect x="7" y="7" width="26" height="9" rx="3" />
                    <rect x="7" y="24" width="26" height="9" rx="3" />
                    <path d="M13 11.5h.01M13 28.5h.01M20 16v8" />
                  </svg>
                )}
                {stage.icon === 'android' && (
                  <svg viewBox="0 0 40 40">
                    <rect x="11" y="4" width="18" height="32" rx="5" />
                    <path d="M17 9h6M18 31h4" />
                  </svg>
                )}
              </div>
              <p>{stage.role}</p>
              <h3>{stage.name}</h3>
              <span>{stage.detail}</span>
            </article>
            {stage.connection && (
              <div class="architecture__connection" aria-hidden="true">
                <small>{stage.connection}</small>
                <span>→</span>
              </div>
            )}
          </li>
        ))
      }
    </ol>

    <p class="workflow__routing">
      <strong>Bagaimana kondisi memengaruhi rute?</strong>
      GATHRA mempertimbangkan area banjir yang terpantau saat mengevaluasi rute dan dapat memberikan alternatif
      dengan paparan lebih rendah ketika tersedia.
    </p>
  </div>
</section>

<style>
  .architecture {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .architecture__stage {
    position: relative;
    min-width: 0;
  }
  .architecture__card {
    min-height: 17.5rem;
    padding: 1.45rem;
    border: 1px solid var(--color-blue-100);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }
  .architecture__icon {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 2rem;
    place-items: center;
    border-radius: 1rem;
    color: var(--color-blue-700);
    background: var(--color-blue-50);
  }
  .architecture__icon svg {
    width: 2.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .architecture__card p {
    color: var(--color-orange-700);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .architecture__card h3 {
    margin-top: 0.35rem;
  }
  .architecture__card > span {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-neutral-600);
    font-size: 0.87rem;
  }
  .architecture__connection {
    position: absolute;
    z-index: 2;
    top: 7rem;
    right: -2.1rem;
    display: grid;
    width: 2.55rem;
    justify-items: center;
    color: var(--color-blue-700);
  }
  .architecture__connection small {
    padding: 0.16rem 0.35rem;
    border-radius: var(--radius-pill);
    background: var(--color-white);
    font-size: 0.6rem;
    font-weight: 760;
  }
  .architecture__connection span {
    font-size: 1.5rem;
    line-height: 1;
  }
  .workflow__routing {
    max-width: 59rem;
    margin: 2rem auto 0;
    padding: 1.2rem 1.4rem;
    border-left: 4px solid var(--color-orange-500);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-neutral-600);
    background: var(--color-orange-50);
  }
  .workflow__routing strong {
    color: var(--color-blue-950);
  }
  @media (max-width: 62rem) {
    .architecture {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.5rem;
    }
    .architecture__stage:nth-child(2) .architecture__connection {
      display: none;
    }
  }
  @media (max-width: 38rem) {
    .architecture {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .architecture__card {
      min-height: 0;
    }
    .architecture__connection,
    .architecture__stage:nth-child(2) .architecture__connection {
      top: auto;
      right: 50%;
      bottom: -2.8rem;
      display: grid;
      transform: translateX(50%) rotate(90deg);
    }
    .architecture__connection small {
      transform: rotate(-90deg);
    }
  }
</style>
