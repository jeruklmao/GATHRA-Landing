---
import SectionHeading from './SectionHeading.astro';

const problems = [
  {
    number: '01',
    title: 'Kondisi berasal dari lapangan',
    description:
      'Sensor GATHRA mengukur kondisi permukaan air dan lingkungan secara berkala di area pemantauan.',
  },
  {
    number: '02',
    title: 'Informasi hadir di peta',
    description:
      'Aplikasi Android menampilkan area yang dipantau, kondisi sensor terkini, dan konteks banjir yang diketahui.',
  },
  {
    number: '03',
    title: 'Rute dinilai dengan konteks banjir',
    description:
      'GATHRA membandingkan kandidat rute terhadap area banjir terpantau dan menampilkan alternatif ketika tersedia.',
  },
];
---

<section class="section problem" id="tentang" aria-labelledby="problem-heading">
  <div class="container">
    <div id="problem-heading">
      <SectionHeading
        eyebrow="Dari sensor ke perjalanan"
        title="Apa yang dilakukan GATHRA?"
        description="GATHRA membuat kondisi area pemantauan lebih mudah dipahami dan membawanya ke dalam pertimbangan rute—tanpa menjanjikan bahwa suatu perjalanan pasti aman."
      />
    </div>

    <div class="problem__grid">
      {
        problems.map((problem) => (
          <article class="problem-card">
            <div class="problem-card__top">
              <span class="problem-card__number" aria-hidden="true">
                {problem.number}
              </span>
              <svg viewBox="0 0 48 48" aria-hidden="true">
                <path
                  d="M7 34c6-14 12-20 19-16 5 3 6 10 15 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.7"
                  stroke-linecap="round"
                />
                <circle cx="7" cy="34" r="3.5" fill="currentColor" />
                <circle cx="41" cy="22" r="3.5" fill="#d95700" />
              </svg>
            </div>
            <h3>{problem.title}</h3>
            <p>{problem.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .problem__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .problem-card {
    min-width: 0;
    padding: clamp(1.35rem, 3vw, 2rem);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .problem-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-blue-200);
    box-shadow: var(--shadow-md);
  }

  .problem-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.4rem;
  }

  .problem-card__number {
    color: var(--color-blue-700);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .problem-card svg {
    width: 2.75rem;
    color: var(--color-blue-700);
  }

  .problem-card p {
    margin-top: 0.75rem;
    color: var(--color-neutral-600);
    font-size: 0.94rem;
  }

  @media (max-width: 48rem) {
    .problem__grid {
      grid-template-columns: 1fr;
    }

    .problem-card__top {
      margin-bottom: 1.5rem;
    }
  }
</style>
