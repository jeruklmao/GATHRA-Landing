---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class:list={['brand', { 'brand--compact': compact }]}>
  <img class="brand__mark" src="/brand/gathra-logo.svg" alt="" width="512" height="512" />
  <span class="brand__word">GATHRA</span>
</span>
<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.62rem;
  }
  .brand__mark {
    width: 2.55rem;
    height: 2.55rem;
    flex: 0 0 auto;
  }
  .brand__word {
    color: var(--color-blue-800);
    font-size: 1.08rem;
    font-weight: 830;
    letter-spacing: 0.12em;
    line-height: 1;
  }
  .brand--compact .brand__mark {
    width: 2.25rem;
    height: 2.25rem;
  }
  @media (max-width: 23rem) {
    .brand__word {
      font-size: 0.98rem;
      letter-spacing: 0.09em;
    }
  }
</style>
