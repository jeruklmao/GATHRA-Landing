---
import FeatureIcon from './FeatureIcon.astro';
import SectionHeading from './SectionHeading.astro';

const features = [
  {
    icon: 'flood' as const,
    title: 'Pemantauan banjir berbasis sensor',
    description:
      'Melihat kondisi area yang dipantau menggunakan pengukuran berkala dari sensor GATHRA.',
  },
  {
    icon: 'risk' as const,
    title: 'Visualisasi area risiko',
    description:
      'Area pemantauan dan status kondisi ditampilkan langsung pada peta dengan kategori yang jelas.',
  },
  {
    icon: 'modes' as const,
    title: 'Informasi sensor terkini',
    description:
      'Melihat ketinggian air, jarak permukaan, suhu, kelembapan, dan status pengukuran yang tersedia.',
  },
  {
    icon: 'routes' as const,
    title: 'Analisis rute alternatif',
    description:
      'Rute dievaluasi dengan mempertimbangkan area banjir yang diketahui dan dibandingkan saat alternatif tersedia.',
  },
  {
    icon: 'search' as const,
    title: 'Pencarian lokasi',
    description: 'Mencari tujuan atau memilih titik pada peta dalam wilayah layanan pilot.',
  },
  {
    icon: 'navigation' as const,
    title: 'Navigasi turn-by-turn',
    description:
      'Mengikuti petunjuk perjalanan dengan pembaruan rute ketika posisi atau kondisi banjir berubah.',
  },
];
---

<section class="section section--muted features" id="fitur" aria-labelledby="features-heading">
  <div class="container">
    <div id="features-heading">
      <SectionHeading
        eyebrow="Pengalaman Android"
        title="Fitur utama"
        description="Aplikasi menyatukan peta, informasi sensor, pencarian, evaluasi rute, dan navigasi dalam pengalaman yang mudah dipahami."
      />
    </div>

    <div class="features__grid">
      {
        features.map((feature) => (
          <article class="feature-card">
            <div class="feature-card__icon">
              <FeatureIcon name={feature.icon} />
            </div>
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .feature-card {
    display: grid;
    min-width: 0;
    min-height: 15rem;
    align-content: space-between;
    gap: 2.25rem;
    padding: clamp(1.3rem, 2.7vw, 1.8rem);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: 0 1px 2px rgb(7 26 56 / 3%);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
  }

  .feature-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-blue-200);
  }

  .feature-card__icon {
    display: grid;
    width: 3.75rem;
    height: 3.75rem;
    place-items: center;
    border: 1px solid var(--color-blue-100);
    border-radius: 1.15rem;
    color: var(--color-blue-700);
    background: var(--color-blue-50);
  }

  .feature-card p {
    margin-top: 0.7rem;
    color: var(--color-neutral-600);
    font-size: 0.92rem;
  }

  @media (max-width: 56rem) {
    .features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .features__grid {
      grid-template-columns: 1fr;
    }

    .feature-card {
      min-height: 0;
      gap: 1.5rem;
    }
  }
</style>
