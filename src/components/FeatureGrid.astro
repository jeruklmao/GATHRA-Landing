---
import FeatureIcon from './FeatureIcon.astro';
import SectionHeading from './SectionHeading.astro';

const features = [
  {
    icon: 'routes' as const,
    title: 'Analisis rute alternatif',
    description:
      'Bandingkan rute utama dan alternatif yang tersedia untuk titik perjalanan pilihan.',
  },
  {
    icon: 'flood' as const,
    title: 'Visualisasi indikasi banjir',
    description:
      'Lihat area berpoligon yang ditandai berdasarkan snapshot data banjir yang tersedia.',
  },
  {
    icon: 'risk' as const,
    title: 'Informasi tingkat risiko rute',
    description:
      'Pahami tingkat risiko dan konteks evaluasi pada setiap pilihan rute yang ditampilkan.',
  },
  {
    icon: 'search' as const,
    title: 'Pencarian lokasi',
    description:
      'Cari lokasi dalam wilayah pilot atau tentukan titik secara langsung melalui peta.',
  },
  {
    icon: 'navigation' as const,
    title: 'Navigasi turn-by-turn',
    description:
      'Ikuti petunjuk perjalanan, progres rute, dan penghitungan ulang selama navigasi aktif.',
  },
  {
    icon: 'modes' as const,
    title: 'Dukungan mobil dan motor',
    description: 'Pilih moda mobil atau motor sebelum membandingkan rute untuk perjalanan Anda.',
  },
];
---

<section class="section section--muted features" id="fitur" aria-labelledby="features-heading">
  <div class="container">
    <div id="features-heading">
      <SectionHeading
        eyebrow="Kemampuan terverifikasi"
        title="Fitur utama"
        description="Fitur berikut tersedia pada pilot Android saat ini dan disajikan tanpa klaim di luar kemampuan sistem."
      />
    </div>

    <div class="features__grid">
      {
        features.map((feature) => (
          <article class="feature-card">
            <div class="feature-card__icon">
              <FeatureIcon name={feature.icon} />
            </div>
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .feature-card {
    display: grid;
    min-width: 0;
    min-height: 15rem;
    align-content: space-between;
    gap: 2.25rem;
    padding: clamp(1.3rem, 2.7vw, 1.8rem);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: 0 1px 2px rgb(7 26 56 / 3%);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
  }

  .feature-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-blue-200);
  }

  .feature-card__icon {
    display: grid;
    width: 3.75rem;
    height: 3.75rem;
    place-items: center;
    border: 1px solid var(--color-blue-100);
    border-radius: 1.15rem;
    color: var(--color-blue-700);
    background: var(--color-blue-50);
  }

  .feature-card p {
    margin-top: 0.7rem;
    color: var(--color-neutral-600);
    font-size: 0.92rem;
  }

  @media (max-width: 56rem) {
    .features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .features__grid {
      grid-template-columns: 1fr;
    }

    .feature-card {
      min-height: 0;
      gap: 1.5rem;
    }
  }
</style>
